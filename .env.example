# Copy to .env locally. Never commit real values.
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-3.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIMENSIONS=768

# Shared development staff key. Generate a strong secret locally.
REX_CATALOG_ADMIN_KEY=
# Optional absolute storage override; blank uses data/catalog under this repository.
REX_CATALOG_DATA_DIR=
REX_API_URL=http://127.0.0.1:8000
REX_AI_TIMEOUT_SECONDS=90

# Optional local stdio MCP staff capability. Must match REX_CATALOG_ADMIN_KEY.
# Leave blank for public-only MCP tools. Never put credentials into tool prompts.
REX_MCP_STAFF_KEY=
# Enable only when intentionally running the paid live connectivity test.
REX_RUN_LIVE_TESTS=0

# Isolated sample mode is set automatically by python scripts/run_demo.py.
REX_APP_MODE=academy
REX_DEMO_DATA_DIR=
# Optional absolute path to an external sample pack; not included in the repository.
REX_DEMO_EXAMPLES_DIR=
# Optional RFP overrides; host routes use the existing catalog administrator key.
RFP_DATA_DIR=
REX_CURRICULUM_DIR=
RFP_GEMINI_MODEL=

# Free-tier text generation; save real keys only in your local .env.
REX_AI_PROVIDER=groq
GROQ_API_KEY=
GROQ_TEXT_MODEL=openai/gpt-oss-20b
# SQLite full-text RAG requires no embedding API or model downloads.
REX_RETRIEVAL_BACKEND=sqlite
# Provider web search may have separate pricing. Disabled by default.
REX_ENABLE_AI_WEB_SEARCH=0
